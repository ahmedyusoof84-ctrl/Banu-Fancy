NODE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Required in production: generate at least 32 random bytes.
JWT_SECRET=
# Leave blank for embedded PostgreSQL (PGlite) for a single-process local installation.
DATABASE_URL=
DATA_DIR=./data
# Used only to bootstrap the first administrator. Set both before first start.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
SHOP_NAME=Smart Retail
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
